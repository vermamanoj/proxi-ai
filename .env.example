# Proxi Environment Configuration
# Copy this file to .env and fill in your values

# Required: Google Gemini API Key
# Get one at: https://ai.google.dev/
# Used by: Core (backend) and Frontend (voice mode via VITE_GEMINI_API_KEY build arg)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Voice Mode: The docker-compose passes GEMINI_API_KEY as VITE_GEMINI_API_KEY
# at build time. If you're running frontend locally (npm run dev), set this:
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token
# Required for GitHub integration tools (create_github_issue, update_github_file)
# GITHUB_TOKEN=your_github_token_here

# Agent API Key - Shared secret between Core and Agents
# Generate a random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be the same on Core and all Agents
PROXI_AGENT_KEY=your_agent_key_here

# Development Mode - DISABLE for production!
# When true, skips command approval prompts and allows blocked commands
# Useful for demos, video recording, and sandbox testing
# Set to: true, 1, or yes to enable
PROXI_DEV_MODE=false
