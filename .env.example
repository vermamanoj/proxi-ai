# Proxi Environment Configuration
# Copy this file to .env and fill in your values

# Required: Google Gemini API Key
# Get one at: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token
# Required for GitHub integration tools (create_github_issue, update_github_file)
# GITHUB_TOKEN=your_github_token_here

# Runtime Mode
# DEMO = Safe simulation mode (recommended for testing/demos)
# REAL = Actual mouse/keyboard/shell control (use with caution)
RUNTIME_MODE=DEMO
