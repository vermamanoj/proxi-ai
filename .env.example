# Proxi Environment Configuration
# Copy this file to .env and fill in your values

# Required: Google Gemini API Key (Core only - Agent doesn't need this)
# Get one at: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: GitHub Personal Access Token
# Required for GitHub integration tools (create_github_issue, update_github_file)
# GITHUB_TOKEN=your_github_token_here

# Agent API Key - Shared secret between Core and Agents
# Generate a random key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must be the same on Core and all Agents
PROXI_AGENT_KEY=your_agent_key_here
